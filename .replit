modules = ["nodejs-24", "python-base-3.13", "rust-stable", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["webkitgtk_4_1", "librsvg", "gtk3", "glib", "openssl", "pkg-config", "zlib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "libdrm", "pango", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libX11", "mesa", "alsa-lib", "libgbm", "libxkbcommon"]

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_j84fxEQcXprzvZ"
WHOP_PLAN_ENTERPRISE = "plan_SC9d2fuJGdCou"
WHOP_PLAN_PROFESSIONAL = "plan_VkGHxtAAChF3e"
WHOP_PLAN_STARTER = "plan_kuPVDFTDfLPEu"
WHOP_PRODUCT_ID = "prod_keK8sXeY9P2le"

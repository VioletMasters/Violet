{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "hosted-printer",
  "description": "Allow the trusted hosted Violet application to enumerate and dispatch local printers.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://Violetsolutions.replit.app",
      "https://violetenterprise.online"
    ]
  },
  "permissions": [
    "allow-list-native-printers",
    "allow-print-native-document"
  ]
}
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://Violetsolutions.replit.app",
      "https://violetenterprise.online"
    ]
  },
  "permissions": [
    "list_native_printers",
    "print_native_document"
  ]
}
# ─────────────────────────────────────────────────────────────────────────────
# Violet Enterprise — Environment Variables
# Copy this file to .env and fill in every value before running docker compose.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string — do not change this when using docker compose;
# it points to the 'db' service defined in docker-compose.yml.
DATABASE_URL=postgresql://violet:violetpass@db:5432/violetdb

# A long, random secret used to sign session tokens.
# Generate one by running:  openssl rand -hex 32
# The server will refuse to start if this is empty or shorter than 32 characters.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Your admin account — this user gets super-admin access to the platform.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=YourStrongPasswordHere

# Published Violet URL used for mandatory online license verification.
# This must be the HTTPS URL of your Violet cloud account.
VIOLET_LICENSE_SERVER_URL=https://your-violet-domain.example

# Optional stable installation identifier. If blank, one is derived from SESSION_SECRET.
VIOLET_INSTALLATION_ID=

# Internal port the API server listens on (used inside Docker — leave as 8080).
PORT=8080

# Postgres credentials — used by the 'db' service in docker-compose.yml.
# Change these to something private before exposing to a network.
POSTGRES_USER=violet
POSTGRES_PASSWORD=violetpass
POSTGRES_DB=violetdb
